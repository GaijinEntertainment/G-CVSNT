#!/bin/bash
export BUILD_ARCH="-arch x86_64 -msse4.1 -mmacosx-version-min=10.11"
export PKG_BUILD_SUFFIX="-osx10.11-x64"
#export BUILD_ARCH="-arch x86_64 -msse4.1 -mavx -mavx2 -mavx512f -mmacosx-version-min=10.15"
#export PKG_BUILD_SUFFIX="-osx10.15-x64"
#export BUILD_ARCH="-arch arm64 -mmacosx-version-min=11.0"
#export PKG_BUILD_SUFFIX="-osx11-arm64"
#export BUILD_ARCH="-arch arm64 -mmacosx-version-min=13.0"
#export PKG_BUILD_SUFFIX="-osx13-arm64"

if ! command -v brew &> /dev/null
then
    echo "brew not found but required"
    echo "install brew with:"
    echo "  /bin/bash -c \"\$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/master/install.sh)\""
    exit 1

    # brew may be later uninstalled with
    #   /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/master/uninstall.sh)"
fi

brew install autoconf
brew install automake
brew install pkg-config
brew install libtool
brew install pcre
brew install openssl@3
rm /usr/local/include/openssl
if [ -d "/usr/local/opt/openssl@3" ]; then
  ln -fs /usr/local/opt/openssl@3/include/openssl /usr/local/include/openssl
  ln -fs /usr/local/opt/openssl@3/lib/libcrypto.dylib /usr/local/lib
  ln -fs /usr/local/opt/openssl@3/lib/libopenssl.a /usr/local/lib
  ln -fs /usr/local/opt/openssl@3/lib/libopenssl.dylib /usr/local/lib
  ln -fs /usr/local/opt/openssl@3/lib/libopenssl.a /usr/local/lib
elif [ -d "/opt/homebrew/opt/openssl@3" ]; then
  ln -fs /opt/homebrew/opt/openssl@3/include/openssl /usr/local/include/openssl
  ln -fs /opt/homebrew/opt/openssl@3/lib/libcrypto.dylib /usr/local/lib
  ln -fs /opt/homebrew/opt/openssl@3/lib/libcrypto.a /usr/local/lib
  ln -fs /opt/homebrew/opt/openssl@3/lib/libopenssl.a /usr/local/lib
else
  echo "ERROR: could not detect openssl@3 location!"
fi

cd cvsnt-2.5.05.3744
autoreconf -i --force
if [ $? != 0 ]; then
  echo "ERROR: autoconf failed!"
  exit 2
fi

cd zstd
CFLAGS="$BUILD_ARCH" LDFLAGS="$BUILD_ARCH" make clean install
cd ..

cd osx
./build-mac
if [ $? != 0 ]; then
  echo "ERROR: build-mac failed!"
  exit 3
fi
cd ../..
echo "build-mac succeeded, don't forget to remove changes added by build via 'git checkout .'"
